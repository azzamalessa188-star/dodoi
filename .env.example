# ── Dodoi configuration ─────────────────────────────────────────────
# You can edit this file directly, or use Settings inside the app.
# Changes to the API connection are picked up on the next translation.
# The app stores its live .env in this folder during development and
# in the user-data folder after packaging.

DODOI_PROVIDER="openai"
DODOI_API_KEY=""
DODOI_API_URL="https://api.openai.com/v1"
DODOI_MODEL="gpt-4o-mini"
DODOI_TARGET_LANGUAGE="English"
DODOI_SHORTCUT="Shift+`"
DODOI_LAUNCH_AT_STARTUP="false"
DODOI_SMART_FALLBACK="true"
DODOI_FALLBACK_PROVIDER="openai"
DODOI_FALLBACK_API_URL="https://api.openai.com/v1"
DODOI_FALLBACK_MODEL="gpt-4o-mini"
