{
  "name": "dodoi",
  "productName": "Dodoi",
  "version": "0.1.0",
  "description": "A floating AI translator for every app.",
  "homepage": "https://dodoi.app",
  "main": "electron/main.cjs",
  "desktopName": "dodoi.desktop",
  "author": "Dodoi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "icons": "node scripts/generate-icons.cjs",
    "verify:model": "node scripts/verify-local-model.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.9",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.1",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.16",
    "vite": "^7.2.2",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "app.dodoi.translator",
    "productName": "Dodoi",
    "copyright": "Copyright © 2026 Dodoi",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/tray.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "LICENSE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/local",
        "to": "local-engine",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "local-models",
        "to": "local-engine/models",
        "filter": [
          "nllb-200-3.3B-int8/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Dodoi uses accessibility access to paste translated text into the app you were using.",
        "LSUIElement": true,
        "NSHumanReadableCopyright": "Copyright © 2026 Dodoi"
      }
    },
    "dmg": {
      "title": "${productName} ${version} ${arch}",
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "iconTextSize": 13,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications",
          "name": "Applications"
        }
      ],
      "license": "LICENSE"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dodoi",
      "uninstallDisplayName": "Dodoi ${version}",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility;TextTools;",
      "description": "Floating AI translator for every app",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Keywords": "translate;translation;language;offline;NLLB;AI;",
          "StartupWMClass": "dodoi"
        }
      }
    },
    "deb": {
      "packageName": "dodoi",
      "packageCategory": "utils",
      "priority": "optional",
      "maintainer": "Dodoi <support@dodoi.app>",
      "vendor": "Dodoi",
      "synopsis": "Floating AI translator for every app",
      "description": "Dodoi is a floating AI translator that lives above every app. Summon it with a global shortcut, translate with a cloud provider or the bundled offline NLLB engine, and paste the result back into the app you were using."
    }
  }
}
